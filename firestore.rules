rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownProfile(userId) { return signedIn() && request.auth.uid == userId; }
    function role() { return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null; }
    function admin() { return role() == 'admin'; }

    match /users/{userId} {
      allow read: if ownProfile(userId) || admin();
      allow create, update: if admin();
      allow delete: if admin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /grades/{gradeId} {
      // Modo gratuito de prueba: únicamente administradores. En producción,
      // Cloud Functions validará asignaciones docentes y cierre de periodos.
      allow read: if admin();
      allow create, update: if admin();
      allow delete: if false;

      match /history/{historyId} {
        allow read, create: if admin();
        allow update, delete: if false;
      }
    }
  }
}
