rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownProfile(userId) { return signedIn() && request.auth.uid == userId; }
    function admin() { return signedIn() && request.auth.token.role == 'admin'; }
    function teacher() { return signedIn() && request.auth.token.role == 'teacher'; }

    match /users/{userId} {
      allow read: if ownProfile(userId) || admin();
      allow create: if ownProfile(userId);
      allow update: if ownProfile(userId) || admin();
      allow delete: if admin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /grades/{gradeId} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || admin() || teacher());
      // La escritura final se realizará desde Cloud Functions, no desde el cliente.
      allow write: if false;
    }
  }
}

