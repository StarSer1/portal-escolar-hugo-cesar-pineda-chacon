{
  "name": "portal-escolar-hugo-cesar-pineda-chacon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["functions"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
