VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dirección pública del sitio (enlaces para redes sociales y sitemap.xml).
# Sin dominio propio se usa https://portal-escolar-hugo-pineda.web.app
VITE_SITE_URL=

# Archivos del sitio público (documentos y fotos). Ver docs/cloudinary.md.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Interruptores para producción (requieren plan Blaze y Cloud Functions; ver docs/despliegue.md).
# unsigned | signed  → firma de subidas a Cloudinary en el servidor.
VITE_UPLOAD_SIGNING=unsigned
# browser | functions → alta de cuentas docentes desde una Cloud Function.
VITE_TEACHER_PROVISIONING=browser
# Clave de reCAPTCHA Enterprise para App Check (opcional; vacío = desactivado).
VITE_APPCHECK_SITE_KEY=

# Activar solo junto con un projectId que comience con demo-.
# Los emuladores deben estar ejecutándose: npm run emulators.
VITE_USE_EMULATORS=false
